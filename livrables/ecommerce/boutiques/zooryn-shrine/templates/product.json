              "name": "Custom Liquid",
              "settings": {
                "custom_liquid": "<style>\n  .zooryn-press-wrapper {\n    width: 100%;\n    margin-top: -64px;\n    margin-bottom: 26px;\n  }\n\n  .zooryn-press-bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    gap: clamp(10px, 3vw, 34px);\n    width: 100%;\n    padding: 28px 20px;\n    box-sizing: border-box;\n    overflow: hidden;\n    background-color: #6E4E37;\n  }\n\n  \n\n  .zooryn-official-logo {\n    display: block;\n    flex: 1 1 0;\n    min-width: 0;\n    height: 36px;\n    background-color: #EDE6D9;\n\n    -webkit-mask-position: center;\n    -webkit-mask-repeat: no-repeat;\n    -webkit-mask-size: contain;\n\n    mask-position: center;\n    mask-repeat: no-repeat;\n    mask-size: contain;\n  }\n\n\n\n.zooryn-official-vogue {\n  max-width: 150px;\n\n  -webkit-mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/f/f8/VOGUE_LOGO.svg\");\n  mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/f/f8/VOGUE_LOGO.svg\");\n}\n\n  \n\n  .zooryn-official-instyle {\n    max-width: 145px;\n\n    -webkit-mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/6/62/InStyle.svg\");\n    mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/6/62/InStyle.svg\");\n  }\n\n  \n\n  .zooryn-official-elle {\n    max-width: 115px;\n\n    -webkit-mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/9/9c/ELLE_Magazine_Logo.svg\");\n    mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/9/9c/ELLE_Magazine_Logo.svg\");\n  }\n\n\n\n.zooryn-official-glamour {\n  max-width: 150px;\n\n  -webkit-mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/b/ba/Glamour_logo.svg\");\n  mask-image: url(\"https://upload.wikimedia.org/wikipedia/commons/b/ba/Glamour_logo.svg\");\n}\n\n  @media screen and (max-width: 749px) {\n    .zooryn-press-wrapper {\n      position: relative;\n      left: 50%;\n      width: 100vw;\n      margin-top: -64px;\n      margin-bottom: 28px;\n      margin-left: -50vw;\n    }\n\n    .zooryn-press-bar {\n      width: 100%;\n      gap: 8px;\n      padding: 20px 13px;\n    }\n\n    .zooryn-official-logo {\n      height: 27px;\n    }\n\n    .zooryn-official-vogue {\n      max-width: 75px;\n    }\n\n    .zooryn-official-instyle {\n      max-width: 72px;\n    }\n\n    .zooryn-official-elle {\n      max-width: 55px;\n    }\n\n    .zooryn-official-glamour {\n      max-width: 90px;\n    }\n  }\n\n  @media screen and (max-width: 370px) {\n    .zooryn-press-bar {\n      gap: 6px;\n      padding-right: 10px;\n      padding-left: 10px;\n    }\n\n    .zooryn-official-logo {\n      height: 24px;\n    }\n  }\n\n  /* ===== DESKTOP UNIQUEMENT (ajout Claude, 01/09) ===== */\n  @media screen and (min-width: 750px) {\n    .zooryn-press-wrapper {\n      margin-top: 0;\n      margin-bottom: 22px;\n    }\n\n    .zooryn-press-bar {\n      justify-content: space-between;\n      gap: 26px;\n      padding: 18px 26px;\n      border-radius: 10px;\n    }\n\n    .zooryn-official-logo {\n      height: 26px;\n    }\n  }\n</style>\n\n<div class=\"zooryn-press-wrapper\">\n  <div class=\"zooryn-press-bar\" aria-label=\"Ils parlent de nous\">\n\n    <span\n      class=\"zooryn-official-logo zooryn-official-vogue\"\n      role=\"img\"\n      aria-label=\"Vogue\">\n    </span>\n\n    <span\n      class=\"zooryn-official-logo zooryn-official-instyle\"\n      role=\"img\"\n      aria-label=\"InStyle\">\n    </span>\n\n    <span\n      class=\"zooryn-official-logo zooryn-official-elle\"\n      role=\"img\"\n      aria-label=\"ELLE\">\n    </span>\n\n    <span\n      class=\"zooryn-official-logo zooryn-official-glamour\"\n      role=\"img\"\n      aria-label=\"Glamour\">\n    </span>\n\n  </div>\n</div>"
              },
              "blocks": {}
            },
            "custom_liquid_MUKXYp": {
              "type": "custom-liquid",
              "name": "Custom Liquid",
              "settings": {
                "custom_liquid": "<style>\n  .zooryn-celebrity-proof {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    gap: 9px;\n    width: 100%;\n    padding: 8px 0;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .zooryn-celebrity-faces {\n    display: block;\n    flex: 0 0 auto;\n    width: 74px;\n    height: 38px;\n    object-fit: contain;\n    background-color: #EDE6D9;\n  }\n\n  .zooryn-celebrity-names {\n    flex: 0 0 auto;\n    color: #171717;\n    font-family: inherit;\n    font-size: clamp(13px, 2.2vw, 20px);\n    line-height: 1;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  .zooryn-verified-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n    width: 24px;\n    height: 24px;\n  }\n\n  .zooryn-verified-badge img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n  }\n\n  .zooryn-celebrity-description {\n    min-width: 0;\n    color: #7d8290;\n    font-family: inherit;\n    font-size: clamp(12px, 2.1vw, 19px);\n    line-height: 1.2;\n    font-weight: 400;\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .zooryn-celebrity-proof {\n      flex-wrap: wrap;\n      column-gap: 5px;\n      row-gap: 0;\n      padding-top: 4px;\n      padding-bottom: 0;\n      margin-bottom: 18px;\n      overflow: visible;\n    }\n\n    .zooryn-celebrity-faces {\n      width: 55px;\n      height: 29px;\n    }\n\n    .zooryn-celebrity-names {\n      font-size: clamp(9px, 2.75vw, 13px);\n    }\n\n    .zooryn-verified-badge {\n      width: 17px;\n      height: 17px;\n    }\n\n    .zooryn-celebrity-description {\n      flex: 0 0 100%;\n      width: 100%;\n      margin-top: -2px;\n      margin-left: 60px;\n      font-size: clamp(10px, 3vw, 13px);\n      line-height: 1;\n      white-space: normal;\n    }\n  }\n\n  @media screen and (max-width: 370px) {\n    .zooryn-celebrity-proof {\n      column-gap: 4px;\n    }\n\n    .zooryn-celebrity-faces {\n      width: 49px;\n      height: 26px;\n    }\n\n    .zooryn-celebrity-names {\n      font-size: 8.5px;\n    }\n\n    .zooryn-verified-badge {\n      width: 15px;\n      height: 15px;\n    }\n\n    .zooryn-celebrity-description {\n      margin-left: 53px;\n      font-size: 10px;\n    }\n  }\n\n  /* ===== DESKTOP UNIQUEMENT (ajout Claude, 01/09) ===== */\n  @media screen and (min-width: 750px) {\n    .zooryn-celebrity-proof {\n      flex-wrap: nowrap;\n      gap: 8px;\n      padding: 0 0 2px;\n    }\n\n    .zooryn-celebrity-faces {\n      width: 58px;\n      height: 30px;\n    }\n\n    .zooryn-celebrity-names {\n      flex: 0 0 auto;\n      font-size: 15px;\n    }\n\n    .zooryn-verified-badge {\n      width: 18px;\n      height: 18px;\n    }\n\n    /* la cause du texte en colonne verticale : sans flex-shrink:0, min-width:0\n       laissait ce bloc etre ecrase a 0 de large par les elements incompressibles */\n    .zooryn-celebrity-description {\n      flex: 0 0 auto;\n      min-width: auto;\n      font-size: 15px;\n      line-height: 1.2;\n      white-space: nowrap;\n    }\n  }\n</style>\n\n<div class=\"zooryn-celebrity-proof\">\n\n  <!-- TROIS PORTRAITS AVEC FOND BEIGE -->\n  <img\n    class=\"zooryn-celebrity-faces\"\n    alt=\"Hailey Bieber et Cara Delevingne\"\n    src=\"data:image/jpeg;base64,\"\n  >\n\n  <span class=\"zooryn-celebrity-names\">\n    Hailey Bieber, Cara Delevingne\n  </span>\n\n  <!-- BADGE CERTIFIÉ -->\n  <span class=\"zooryn-verified-badge\" aria-label=\"Compte certifié\">\n  <img\n    src=\"https://img.icons8.com/color/48/instagram-verification-badge.png\"\n    alt=\"Badge de certification Instagram\"\n    width=\"24\"\n    height=\"24\"\n  >\n</span>\n\n  <!-- DEUXIÈME LIGNE SUR TÉLÉPHONE -->\n  <span class=\"zooryn-celebrity-description\">\n    et plus de 50 000 femmes portent Zooryn\n  </span>\n\n</div>"
              },
