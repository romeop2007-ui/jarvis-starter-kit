            "custom_liquid_JqXnUP": {
              "type": "custom-liquid",
              "name": "Custom Liquid",
              "settings": {
                "custom_liquid": "<style>\n  .zooryn-product-info {\n    width: 100%;\n    font-family: inherit;\n    color: #292929;\n  }\n\n  \n\n  .zooryn-rating-line {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    gap: clamp(5px, 1.5vw, 14px);\n    width: 100%;\n    margin-bottom: 32px;\n    white-space: nowrap;\n  }\n\n  .zooryn-stars {\n    position: relative;\n    display: inline-block;\n    flex: 0 0 auto;\n    font-size: clamp(17px, 4.2vw, 30px);\n    line-height: 1;\n    letter-spacing: 0;\n    white-space: nowrap;\n  }\n\n  .zooryn-stars-background {\n    color: #ddd6d1;\n  }\n\n  .zooryn-stars-filled {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 94%;\n    overflow: hidden;\n    color: #6E4E37;\n  }\n\n  .zooryn-rating-text {\n    flex: 0 1 auto;\n    min-width: 0;\n    font-size: clamp(11px, 3.15vw, 23px);\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .zooryn-rating-text strong {\n    font-weight: 700;\n  }\n\n  \n\n  .zooryn-price-line {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    gap: clamp(7px, 1.5vw, 14px);\n    width: 100%;\n    white-space: nowrap;\n  }\n\n  .zooryn-compare-price {\n    flex: 0 0 auto;\n    color: #292929;\n    font-size: clamp(19px, 5vw, 29px);\n    line-height: 1;\n    text-decoration: line-through;\n  }\n\n  .zooryn-current-price {\n    flex: 0 0 auto;\n    color: #C1522A;\n    font-size: clamp(20px, 5.2vw, 30px);\n    line-height: 1;\n    font-weight: 500;\n  }\n\n  .zooryn-discount-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 1 1 auto;\n    min-width: 0;\n    padding: clamp(10px, 2.2vw, 14px) clamp(12px, 2.8vw, 22px);\n    border-radius: 11px;\n    background-color: #C1522A;\n    color: #ffffff;\n    font-size: clamp(9px, 2.1vw, 14px);\n    line-height: 1;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .zooryn-rating-line {\n      margin-bottom: 26px;\n    }\n  }\n\n  /* ===== DESKTOP UNIQUEMENT (ajout Claude, 01/09) ===== */\n  @media screen and (min-width: 750px) {\n    .zooryn-rating-line {\n      gap: 10px;\n      margin-bottom: 24px;\n    }\n\n    .zooryn-stars {\n      font-size: 22px;\n    }\n\n    .zooryn-rating-text {\n      font-size: 16px;\n    }\n\n    .zooryn-price-line {\n      gap: 12px;\n    }\n\n    .zooryn-compare-price {\n      font-size: 24px;\n    }\n\n    .zooryn-current-price {\n      font-size: 25px;\n    }\n\n    /* le badge s'etirait sur toute la largeur restante a cause de flex:1 1 auto */\n    .zooryn-discount-badge {\n      flex: 0 0 auto;\n      min-width: auto;\n      padding: 11px 18px;\n      font-size: 12px;\n    }\n  }\n</style>\n\n<div class=\"zooryn-product-info\">\n\n  <div class=\"zooryn-rating-line\">\n    <div class=\"zooryn-stars\" aria-label=\"Note de 4,7 sur 5\">\n      <span class=\"zooryn-stars-background\">★★★★★</span>\n      <span class=\"zooryn-stars-filled\">★★★★★</span>\n    </div>\n\n    <div class=\"zooryn-rating-text\">\n      <strong>4,7/5</strong> · Excellent · <strong>plus de 3 500 avis</strong>\n    </div>\n  </div>\n\n  <div class=\"zooryn-price-line\">\n    {% if product.compare_at_price > product.price %}\n      <span class=\"zooryn-compare-price\">\n        {{ product.compare_at_price | money }}\n      </span>\n    {% endif %}\n\n    <span class=\"zooryn-current-price\">\n      {{ product.price | money }}\n    </span>\n\n    <span class=\"zooryn-discount-badge\">\n      -30% + LIVRAISON OFFERTE\n    </span>\n  </div>\n\n</div>"
              },
              "blocks": {}
            },
            "custom_liquid_JHUGQP": {
              "type": "custom-liquid",
              "name": "Custom Liquid",
              "settings": {
                "custom_liquid": "<style>\n  .zooryn-features-section {\n    width: 100%;\n    padding-top: 22px;\n    padding-bottom: 22px;\n    font-family: inherit;\n    box-sizing: border-box;\n  }\n\n  \n\n  .zooryn-feature-separator {\n    display: block !important;\n    width: 100% !important;\n    height: 1px !important;\n    min-height: 1px !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    background-color: #c7c7c7 !important;\n  }\n\n  .zooryn-feature-separator-top {\n    margin-bottom: 22px !important;\n  }\n\n  .zooryn-feature-separator-bottom {\n    margin-top: 22px !important;\n  }\n\n  \n\n  .zooryn-features-grid {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 12px;\n    width: 100%;\n  }\n\n  .zooryn-features-first-row {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    gap: 12px;\n    width: 100%;\n  }\n\n  \n\n  .zooryn-feature-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 9px;\n    min-width: 0;\n    min-height: 48px;\n    padding: 10px 16px;\n    border-radius: 15px;\n    background-color: #6E4E37;\n    color: #EDE6D9;\n    box-sizing: border-box;\n    white-space: nowrap;\n  }\n\n  .zooryn-feature-icon {\n    width: 20px;\n    height: 20px;\n    flex: 0 0 20px;\n    color: #EDE6D9;\n  }\n\n  .zooryn-feature-icon svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .zooryn-feature-text {\n    min-width: 0;\n    color: #EDE6D9;\n    font-family: inherit;\n    font-size: clamp(11px, 2vw, 16px);\n    line-height: 1.1;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .zooryn-features-section {\n      padding-top: 20px;\n      padding-bottom: 20px;\n    }\n\n    .zooryn-feature-separator-top {\n      margin-bottom: 20px !important;\n    }\n\n    .zooryn-feature-separator-bottom {\n      margin-top: 20px !important;\n    }\n\n    .zooryn-features-grid,\n    .zooryn-features-first-row {\n      gap: 8px;\n    }\n\n    .zooryn-feature-badge {\n      gap: 6px;\n      min-height: 40px;\n      padding: 8px 10px;\n      border-radius: 12px;\n    }\n\n    .zooryn-feature-icon {\n      width: 17px;\n      height: 17px;\n      flex-basis: 17px;\n    }\n\n    .zooryn-feature-text {\n      font-size: clamp(9px, 2.65vw, 13px);\n    }\n  }\n\n  @media screen and (max-width: 370px) {\n    .zooryn-feature-badge {\n      gap: 5px;\n      padding-right: 7px;\n      padding-left: 7px;\n    }\n\n    .zooryn-feature-icon {\n      width: 15px;\n      height: 15px;\n      flex-basis: 15px;\n    }\n\n    .zooryn-feature-text {\n      font-size: 9px;\n    }\n  }\n\n  /* ===== DESKTOP UNIQUEMENT (ajout Claude, 01/09) ===== */\n  @media screen and (min-width: 750px) {\n    .zooryn-features-first-row {\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    .zooryn-features-grid {\n      gap: 10px;\n    }\n\n    /* largeur du contenu, jamais etires sur toute la colonne */\n    .zooryn-feature-badge {\n      flex: 0 0 auto;\n      min-height: 42px;\n      padding: 9px 15px;\n    }\n\n    .zooryn-feature-text {\n      font-size: 14px;\n    }\n\n    .zooryn-feature-icon {\n      width: 18px;\n      height: 18px;\n      flex-basis: 18px;\n    }\n  }\n</style>\n\n<div class=\"zooryn-features-section\">\n\n  <!-- BARRE GRISE DU HAUT -->\n  <div class=\"zooryn-feature-separator zooryn-feature-separator-top\"></div>\n\n  <div class=\"zooryn-features-grid\">\n\n    <!-- PREMIÈRE LIGNE -->\n    <div class=\"zooryn-features-first-row\">\n\n      <!-- BRACELET AJUSTABLE -->\n      <div class=\"zooryn-feature-badge\">\n        <span class=\"zooryn-feature-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 11a2 2 0 0 1 2 2c0 3-.8 5.4-2.1 7.4\"></path>\n            <path d=\"M8.2 21c1.2-2.1 1.8-4.7 1.8-8a2 2 0 0 1 4 0c0 1.2-.1 2.4-.3 3.5\"></path>\n            <path d=\"M5.5 19.2C6.5 17.3 7 15.3 7 13a5 5 0 0 1 10 0c0 2.7-.4 5.2-1.3 7.5\"></path>\n            <path d=\"M3.5 16.5c.4-1.1.5-2.3.5-3.5a8 8 0 0 1 16 0c0 1.7-.1 3.2-.4 4.7\"></path>\n            <path d=\"M5.2 7.2A8.6 8.6 0 0 1 12 4.5c2 0 3.9.7 5.3 1.9\"></path>\n          </svg>\n        </span>\n\n        <span class=\"zooryn-feature-text\">\n          Bracelet ajustable\n        </span>\n      </div>\n\n      <!-- ACIER INOXYDABLE -->\n      <div class=\"zooryn-feature-badge\">\n        <span class=\"zooryn-feature-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 3 20 6v6c0 5-3.4 8.2-8 9.5C7.4 20.2 4 17 4 12V6l8-3Z\"></path>\n            <path d=\"m9 12 2 2 4-4\"></path>\n          </svg>\n        </span>\n\n        <span class=\"zooryn-feature-text\">\n          Acier inox. 1re qualité\n        </span>\n      </div>\n\n    </div>\n\n    <!-- DEUXIÈME LIGNE -->\n    <div class=\"zooryn-feature-badge\">\n      <span class=\"zooryn-feature-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n          <path d=\"M12 7v6h5\"></path>\n        </svg>\n      </span>\n\n      <span class=\"zooryn-feature-text\">\n        Mouvement à quartz et verre minéral\n      </span>\n    </div>\n\n  </div>\n\n  <!-- BARRE GRISE DU BAS -->\n  <div class=\"zooryn-feature-separator zooryn-feature-separator-bottom\"></div>\n\n</div>"
              },
