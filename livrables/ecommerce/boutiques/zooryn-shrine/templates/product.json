                "custom_liquid": "<div class=\"zooryn-offer-banner\">\n\n  <div class=\"zooryn-offer-top\">\n    <span class=\"zooryn-offer-line\"></span>\n\n    <span class=\"zooryn-offer-title\">\n      OFFRE LIMITÉE 24H&nbsp;!\n    </span>\n\n    <span class=\"zooryn-offer-line\"></span>\n  </div>\n\n\n  <div class=\"zooryn-offer-bottom\">\n\n    <span class=\"zooryn-offer-message\">\n      Dépêchez-vous&nbsp;! L'offre expire dans\n    </span>\n\n    <div class=\"zooryn-timer-row\">\n      <span\n        id=\"zooryn-countdown\"\n        class=\"zooryn-offer-countdown\"\n      >\n        24:00:00\n      </span>\n\n      <span class=\"zooryn-offer-clock\">\n        ⏰\n      </span>\n    </div>\n\n  </div>\n\n</div>\n\n\n<style>\n\n  .zooryn-offer-banner {\n    --zooryn-brown: #6E4E37;\n    --zooryn-beige: #EDE6D9;\n\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n    padding: 0;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n\n  /* =========================\n     PARTIE SUPÉRIEURE\n     ========================= */\n\n  .zooryn-offer-top {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    width: 100%;\n    margin-bottom: 14px;\n  }\n\n\n  .zooryn-offer-line {\n    flex: 1;\n    max-width: 210px;\n    height: 3px;\n\n    background: rgba(110, 78, 55, 0.28);\n\n    border-radius: 999px;\n  }\n\n\n  .zooryn-offer-title {\n    color: var(--zooryn-brown);\n\n    font-size: 19px;\n    font-weight: 800;\n    line-height: 1.1;\n\n    letter-spacing: 0.2px;\n\n    text-align: center;\n    text-transform: uppercase;\n\n    white-space: nowrap;\n  }\n\n\n\n  /* =========================\n     BLOC MARRON\n     ========================= */\n\n  .zooryn-offer-bottom {\n    width: 100%;\n\n    background: var(--zooryn-brown);\n    color: var(--zooryn-beige);\n\n    border-radius: 16px;\n\n    padding: 20px 22px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 6px;\n\n    box-sizing: border-box;\n\n    text-align: center;\n\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1.25;\n  }\n\n\n  .zooryn-offer-message {\n    color: var(--zooryn-beige);\n\n    font-weight: 800;\n\n    white-space: nowrap;\n  }\n\n\n  .zooryn-timer-row {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 5px;\n\n    white-space: nowrap;\n  }\n\n\n  .zooryn-offer-countdown {\n    color: var(--zooryn-beige);\n\n    font-weight: 900;\n\n    letter-spacing: 0.5px;\n\n    font-variant-numeric: tabular-nums;\n  }\n\n\n  .zooryn-offer-clock {\n    color: var(--zooryn-beige);\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n\n\n  /* =========================\n     MOBILE\n     ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    .zooryn-offer-top {\n      gap: 12px;\n      margin-bottom: 12px;\n    }\n\n\n    .zooryn-offer-line {\n      max-width: 90px;\n      height: 2px;\n    }\n\n\n    .zooryn-offer-title {\n      font-size: 16px;\n    }\n\n\n    .zooryn-offer-bottom {\n      padding: 18px 8px;\n\n      border-radius: 14px;\n\n      flex-direction: column;\n\n      gap: 8px;\n\n      font-size: clamp(13px, 4vw, 17px);\n    }\n\n\n    /*\n      Empêche absolument :\n      \"Dépêchez-vous ! L'offre expire dans\"\n      de passer sur deux lignes.\n    */\n\n    .zooryn-offer-message {\n      white-space: nowrap;\n\n      font-size: clamp(13px, 4vw, 17px);\n\n      line-height: 1.2;\n    }\n\n\n    .zooryn-timer-row {\n      font-size: 18px;\n      line-height: 1;\n    }\n\n  }\n\n\n\n  /* Très petits téléphones */\n\n  @media screen and (max-width: 360px) {\n\n    .zooryn-offer-bottom {\n      padding-left: 5px;\n      padding-right: 5px;\n    }\n\n\n    .zooryn-offer-message {\n      font-size: 12.5px;\n    }\n\n  }\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  /*\n    COMPTEUR SYNCHRONISÉ SUR PARIS\n\n    Exemple :\n\n    Paris 00:00:00 → 24:00:00\n    Paris 00:00:01 → 23:59:59\n    Paris 01:00:00 → 23:00:00\n    Paris 12:00:00 → 12:00:00\n    Paris 23:59:59 → 00:00:01\n\n    Puis à minuit :\n    → 24:00:00\n\n    Et cela recommence tous les jours.\n  */\n\n\n  var countdownElement =\n    document.getElementById('zooryn-countdown');\n\n\n  if (!countdownElement) {\n    return;\n  }\n\n\n\n  function pad(number) {\n\n    return String(number).padStart(2, '0');\n\n  }\n\n\n\n  function getParisTimeParts() {\n\n    var now = new Date();\n\n\n    var formatter =\n      new Intl.DateTimeFormat(\n        'fr-FR',\n        {\n          timeZone: 'Europe/Paris',\n\n          hour: '2-digit',\n          minute: '2-digit',\n          second: '2-digit',\n\n          hourCycle: 'h23'\n        }\n      );\n\n\n    var parts =\n      formatter.formatToParts(now);\n\n\n    var values = {};\n\n\n    parts.forEach(function (part) {\n\n      if (part.type !== 'literal') {\n\n        values[part.type] =\n          parseInt(part.value, 10);\n\n      }\n\n    });\n\n\n    return {\n      hours: values.hour || 0,\n      minutes: values.minute || 0,\n      seconds: values.second || 0\n    };\n\n  }\n\n\n\n  function updateCountdown() {\n\n    var paris =\n      getParisTimeParts();\n\n\n    /*\n      Nombre de secondes écoulées\n      depuis minuit à Paris.\n    */\n\n    var elapsedSeconds =\n      (paris.hours * 3600)\n      +\n      (paris.minutes * 60)\n      +\n      paris.seconds;\n\n\n\n    /*\n      Temps restant avant le prochain\n      minuit parisien.\n\n      À exactement 00:00:00 :\n      elapsedSeconds = 0\n\n      donc :\n      remainingSeconds = 86400\n\n      → affichage 24:00:00\n    */\n\n    var remainingSeconds =\n      86400 - elapsedSeconds;\n\n\n\n    var hours =\n      Math.floor(\n        remainingSeconds / 3600\n      );\n\n\n    var minutes =\n      Math.floor(\n        (remainingSeconds % 3600) / 60\n      );\n\n\n    var seconds =\n      remainingSeconds % 60;\n\n\n\n    countdownElement.textContent =\n      pad(hours)\n      + ':'\n      + pad(minutes)\n      + ':'\n      + pad(seconds);\n\n  }\n\n\n\n  /*\n    Mise à jour immédiate\n  */\n\n  updateCountdown();\n\n\n\n  /*\n    Puis mise à jour chaque seconde.\n  */\n\n  setInterval(\n    updateCountdown,\n    1000\n  );\n\n\n})();\n\n</script>"
              },
