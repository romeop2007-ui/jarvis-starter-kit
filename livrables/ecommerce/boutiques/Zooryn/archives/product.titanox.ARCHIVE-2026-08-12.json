ant; padding:0 !important; margin:0 !important;\n    font:inherit !important; color:inherit !important;\n    cursor:pointer !important;\n    user-select:none !important;\n    width:auto !important;\n  }\n\n  .zx-sg-wrap .material-symbols-outlined{\n    font-family:'Material Symbols Outlined', sans-serif;\n    font-weight:normal; font-style:normal; line-height:1;\n    display:inline-block;\n    -webkit-font-feature-settings:'liga';\n    -webkit-font-smoothing:antialiased;\n    font-variation-settings:'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;\n  }\n  .zx-sg-wrap .zx-sg-icon{ font-size:20px !important; }\n\n  .zx-sg-wrap .zx-sg-label{\n    font-size:1.35rem !important;\n    font-weight:600 !important;\n    text-decoration:underline !important;\n    text-underline-offset:3px !important;\n    text-decoration-thickness:2px !important;\n    line-height:1.1 !important;\n    text-transform:none !important;\n  }\n\n  /* Popup fermée par défaut */\n  .zx-sg-wrap .zx-sg-overlay{\n    display:none !important;\n    position:fixed !important; inset:0 !important; z-index:2147483000 !important;\n    align-items:center !important; justify-content:center !important;\n    padding:min(24px, 5vw) !important;\n  }\n  /* Ouverte quand la case est cochée */\n  .zx-sg-wrap .zx-sg-toggle:checked ~ .zx-sg-overlay{\n    display:flex !important;\n  }\n\n  .zx-sg-wrap .zx-sg-backdrop{\n    position:absolute !important; inset:0 !important;\n    background:rgba(0,0,0,.5) !important;\n    cursor:pointer !important;\n    margin:0 !important; padding:0 !important; border:0 !important;\n  }\n\n  .zx-sg-wrap .zx-sg-dialog{\n    position:relative !important; background:#fff !important;\n    border-radius:12px !important; box-shadow:0 10px 30px rgba(0,0,0,.25) !important;\n    overflow:hidden !important;\n    width:auto !important;\n    max-width:min(760px, 92vw) !important;\n    max-height:92vh !important;\n    display:inline-flex !important; align-items:center !important; justify-content:center !important;\n  }\n\n  .zx-sg-wrap .zx-sg-image{\n    display:block !important;\n    width:auto !important; height:auto !important;\n    max-width:min(760px, 92vw) !important;\n    max-height:92vh !important;\n  }\n\n  .zx-sg-wrap .zx-sg-close{\n    position:absolute !important; top:6px !important; right:8px !important;\n    background:#fff !important; border:1px solid rgba(0,0,0,.15) !important;\n    border-radius:8px !important; width:32px !important; height:32px !important;\n    display:inline-flex !important; align-items:center !important; justify-content:center !important;\n    cursor:pointer !important; font-size:16px !important; line-height:1 !important;\n    color:#111 !important; margin:0 !important; padding:0 !important;\n    z-index:2 !important;\n  }\n  .zx-sg-wrap .zx-sg-close:hover{ background:#f6f6f6 !important; }\n</style>"
